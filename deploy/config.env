#
# The server's settings, as environment variables (`recess web --help` lists them all).
# Placeholders: replace bar.foo.io with your own domains.

# The issuer everyone signs in with: the same Dex the API server trusts.
RECESS_OIDC_ISSUER=https://dex.bar.foo.io
# The client Recess signs in as. `kubernetes` is the API server's audience; if Recess has a
# client of its own, set its ID here and RECESS_OIDC_AUDIENCE=kubernetes (deploy/README.md).
RECESS_OIDC_CLIENT_ID=kubernetes
# Where browsers reach Recess, through your TLS ingress; Dex redirects to <it>/auth/callback.
RECESS_PUBLIC_URL=https://recess.bar.foo.io
# Where mediatore's broker writes its Secrets and logs.
RECESS_BROKER_NAMESPACE=banlieue-system
RECESS_VIEW=admin
RECESS_LISTEN=0.0.0.0:7480
RECESS_NO_OPEN=1
